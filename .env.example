# =============================================================================
# The Inspire Business Academy — Environment Configuration
# Platform: Cloudflare Pages & Cloudflare Pages Functions
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Client-Safe Variables (Prefixed with VITE_, Bundled at Build Time)
# WARNING: NEVER put SUPABASE_SERVICE_ROLE_KEY or any secret in a VITE_ variable!
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_PUBLIC_SITE_URL="http://localhost:3000"
VITE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# 2. Server-Only Environment Variables (Cloudflare Pages Functions / Backend)
# Store secrets as "Secret" (Encrypted) under Cloudflare Settings > Environment variables.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"
BOOTSTRAP_SECRET="your-admin-bootstrap-secret"

# -----------------------------------------------------------------------------
# 3. Cloudflare Workers AI & AI Gateway (Optional)
# - Native AI Binding: Variable name "AI" under Settings > Functions > Workers AI
# - Gateway ID: Optional AI Gateway identifier for caching, analytics, and rate-limiting
# - Cache TTL: Optional positive integer in seconds for AI Gateway response cache
# - AI Model: Model alias or name (e.g. @cf/meta/llama-3.1-8b-instruct)
# -----------------------------------------------------------------------------
CLOUDFLARE_AI_GATEWAY_ID="default"
CLOUDFLARE_AI_CACHE_TTL="3600"
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
